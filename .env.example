# Copy to .env and fill in. Never commit .env.
# Development works without a .env file (emails go to Mailpit, Google login is off);
# the values below marked "production" are required there.

# --- Production ---

# Public domain served by Caddy (HTTPS certificates are issued automatically).
# Use "localhost" to test the production stack locally.
DOMAIN=tornei.example.com

# MongoDB root credentials, created on first start of the mongo volume.
# Use URL-safe characters only: they are embedded in the connection string.
MONGO_ROOT_USERNAME=tornei
MONGO_ROOT_PASSWORD=change-me

# Image tag to pull from ghcr.io (default: latest). The deploy job pins each release to its commit SHA.
IMAGE_TAG=latest

# Days of daily MongoDB backups kept in ./backups next to the compose file (default: 14).
BACKUP_KEEP_DAYS=14

# --- Authentication ---

# Signs sessions and encrypts OAuth tokens. Required in production; at least 32 characters.
# Generate one with: openssl rand -base64 32
BETTER_AUTH_SECRET=

# Whether new users can register (email sign-up, or a first Google login).
# Default: true in development, false in production. Existing users can always sign in.
# To create the first account in production: set true, restart, sign up, set false, restart.
SIGNUP_ENABLED=

# Google login (optional: the "Continue with Google" button fails if these are empty).
# Create an OAuth client at https://console.cloud.google.com/apis/credentials with redirect URI
#   <app URL>/api/auth/callback/google   (dev: http://localhost:5173/api/auth/callback/google)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Email (production; development uses Mailpit) ---

# Any SMTP server works; switching provider only means changing these values.
SMTP_HOST=smtp.example.com
# 587 with SMTP_SECURE=false (STARTTLS), or 465 with SMTP_SECURE=true
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
# Sender shown in verification and password-reset emails
MAIL_FROM=Tornei <no-reply@tornei.example.com>
