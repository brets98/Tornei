# Copy to .env and fill in. Never commit .env.
# Development works without a .env file; these values are needed in production.

# Public domain served by Caddy (HTTPS certificates are issued automatically).
# Use "localhost" to test the production stack locally.
DOMAIN=tornei.example.com

# MongoDB root credentials, created on first start of the mongo volume.
# Use URL-safe characters only: they are embedded in the connection string.
MONGO_ROOT_USERNAME=tornei
MONGO_ROOT_PASSWORD=change-me

# Image tag to pull from ghcr.io (default: latest).
IMAGE_TAG=latest
